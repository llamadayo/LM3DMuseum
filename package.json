{
  "name": "lm-3d-museum",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-decoders.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-decoders.mjs && tsc -b && vite build && node scripts/check-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check:assets": "node scripts/check-assets.mjs",
    "format": "prettier --write src scripts/*.mjs vite.config.ts index.html README.md .github/workflows/deploy.yml"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "meshoptimizer": "1.2.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
